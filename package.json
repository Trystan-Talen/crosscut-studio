{
  "name": "crosscut-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "tsx src/server/main.ts",
    "worker": "tsx src/server/worker.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run format:check && npm test && vite build",
    "format": "prettier --write src tests scripts/*.{ts,mjs} *.ts *.json",
    "format:check": "prettier --check src tests scripts/*.{ts,mjs} *.ts *.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "10.1.6",
    "archiver": "^7.0.0",
    "better-sqlite3": "13.0.3",
    "cheerio": "^1.1.0",
    "fastify": "5.12.7",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "tsx": "^4.20.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
